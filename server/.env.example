# --- service ---
SNAPIT_PORT=8787
SNAPIT_PUBLIC_URL=http://localhost:8787
# Signs bearer tokens. Prototype stand-in for a real IdP; rotate and it logs everyone out.
SNAPIT_TOKEN_SECRET=change-me-32-bytes-minimum-please

# --- storage: pick one provider ---
# local | s3 | azure | gcs
SNAPIT_STORAGE_PROVIDER=local

# local
SNAPIT_LOCAL_ROOT=./.data/objects

# s3 (also MinIO, Cloudflare R2, and anything S3-compatible)
# SNAPIT_S3_BUCKET=snapit-captures
# SNAPIT_S3_REGION=eu-west-1
# SNAPIT_S3_ACCESS_KEY_ID=
# SNAPIT_S3_SECRET_ACCESS_KEY=
# Omit for AWS. MinIO: http://localhost:9000 · R2: https://<account>.r2.cloudflarestorage.com
# SNAPIT_S3_ENDPOINT=
# MinIO needs this; AWS and R2 do not.
# SNAPIT_S3_FORCE_PATH_STYLE=false

# azure  (shaped, not implemented — see src/storage/azure.ts)
# SNAPIT_AZURE_ACCOUNT=
# SNAPIT_AZURE_CONTAINER=
# SNAPIT_AZURE_ACCOUNT_KEY=

# gcs    (shaped, not implemented — see src/storage/gcs.ts)
# SNAPIT_GCS_BUCKET=
# SNAPIT_GCS_CLIENT_EMAIL=
# SNAPIT_GCS_PRIVATE_KEY=

# --- metadata (prototype: JSON snapshot on disk) ---
SNAPIT_METADATA_FILE=./.data/metadata.json
