{
  "name": "@snapit/server",
  "version": "0.0.0-prototype",
  "private": true,
  "type": "module",
  "description": "Prototype: workspace, auth and metadata for connected mode. Artifacts live in customer-configured storage.",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "push": "node --experimental-strip-types scripts/push.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "token": "node --experimental-strip-types scripts/token.ts"
  }
}
